<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_vendor_maintenance" name="Portal layout : Maintenance Requests" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li id="portal_breadcrumbs_sale" t-if="page_name == 'vendor_maintenance' or vendor_maintenance_request" t-attf-class="breadcrumb-item #{'active ' if not vendor_maintenance_request else ''}">
                <a t-if="vendor_maintenance_request" t-attf-href="/my/vendor_maintenance?{{ keep_query() }}">Vendor Maintenance Requests</a>
                <t t-else="">Vendor Maintenance Requests</t>
            </li>
            <li t-if="vendor_maintenance_request" class="breadcrumb-item active">
                <span t-field="vendor_maintenance_request.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_vendor_maintenance" name="Maintenance Requests" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
            <t t-set="portal_alert_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry"  t-if="env.user.partner_id.is_vendor">
                <t t-set="icon" t-value="'/maintenance/static/description/icon.svg'"/>
                <t t-set="title">Vendor Maintenance Requests</t>
                <t t-set="url" t-value="'/my/vendor_maintenance'"/>
                <t t-set="text">Follow, view or your vendor requests</t>
                <t t-set="placeholder_count" t-value="'vendor_maintenance'"/>
            </t>
        </div>
    </template>

     <template id="portal_my_vendor_maintenance_requests" name="My Vendor Maintenance Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Vendor Maintenance Requests</t>
            </t>
            <div t-if="not maintenance_requests" class="alert alert-warning" role="alert">
                There are currently no Vendor Maintenance Requests for your account.
            </div>
            <t t-if="maintenance_requests" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Number #</th>
                        <th>Subjects</th>
                        <th class="text-end">Request Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <t t-foreach="maintenance_requests" t-as="maintenance_req">
                    <tr>
                        <td><a t-att-href="maintenance_req.with_context(vendor=1).get_portal_url()"><t t-out="maintenance_req.code"/></a></td>
                        <td><t t-out="maintenance_req.name"/></td>
                        <td class="text-end"><span t-field="maintenance_req.request_date"/></td>
                        <td><span t-field="maintenance_req.stage_id"/></td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="template_vendor_maintenance_form" name="Maintenance Requests" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <style>
                    .normal_lable {
                        font-size: 0.7rem;
                        color: #555;
                    }
                     /* Style the form group */
                        .form-group {
                          position: relative;
                          margin-bottom: 2rem;
                        }

                        /* Style for input fields */
                        .form-control {
                          border: 1px solid #ccc;
                          border-radius: 8px;
                          font-size: 1rem;
                          padding: 0.75rem;
                          outline: none;
                          width: 100%;
                        }

                        /* Position the label over the input field */
                        .form-label {
                          position: absolute;
                          top: 0;
                          left: 10px;
                          transform: translateY(-50%);
                          background: white;
                          padding: 0 5px;
                          font-size: 0.9rem;
                          color: #555;
                        }

                        /* Active input field style */
                        .form-control:focus {
                          border-color: #000;
                          outline: none;
                          box-shadow: none;
                        }
                    
                    
                    .image-container {
                      position: relative;
                    }
                    .image-container img {
                      width: 100%; /* Adjust as needed */
                      max-width: 100%;
                      position: relative;
                      z-index: 2;
                    }
                    .image-container .overlap {
                      width: 125%;
                      height: 100%;
                      background: transparent; /* Optional if you want a background for the overlap */
                      z-index: 1;
                    }
                    
                    body {
                        background-color: #f8f9fa;
                    }
                    .left-section {
                        background-color: #2b94d1;
                        color: white;
                        padding: 20px;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        align-items: center;
                    }
                    .left-section h2 {
                        font-size: 1.8rem;
                        text-align: center;
                    }
                    .form-container {
                        background-color: white;
                        padding: 30px;
                        border-radius: 10px;
                        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                    }
                    .form-title {
                        font-weight: bold;
                        text-align: center;
                        margin-bottom: 20px;
                    }
                    .submit-btn {
                        background-color: #2b94d1;
                        color: white;
                        font-weight: bold;
                    }
            </style>
            <div class="row o_portal_sale_sidebar">

                <div id="quote_content" class="col-12 mt-5 mt-lg-0">
                    <div id="portal_sale_content">
                        <div id="introduction" t-attf-class="#{'border-bottom-0 pt-0 pb-3' if report_type == 'html' else ''}">
                            <div class="d-flex gap-2" id="intro_row">
                                <h2>
                                    <em t-out="vendor_maintenance_request.code or vendor_maintenance_request.name"/><span class="ms-2 badge bg-primary" t-field='vendor_maintenance_request.stage_id'/>
                                </h2>
                            </div>
                            <div class="d-flex justify-content-end mb-3">
                                <a t-if="vendor_maintenance_request.check_stage_id('submited_to_vendor')" role="button" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#modalquote" href="#"> <i class="fa fa-clock-o"/> Submit Quote</a>
                                <a t-if="vendor_maintenance_request.check_stage_id('submited_to_vendor')" role="button" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#modaldateresolution" href="#"> <i class="fa fa-clock-o"/> Date Resolution</a>
                                <a t-if="vendor_maintenance_request.check_stage_id('go_ahed_to_vendor')" t-attf-href="/vendor_maintenance/request_done/{{vendor_maintenance_request.id}}?access_token={{access_token}}" class="btn btn-primary me-2"> <i class="fa fa-clock-o"/> Close the request</a>
                            </div>

                        </div>

                        <div id="content">
                            <div id="informations" class="row">
                                <div t-if="vendor_maintenance_request.vendor_quote_att" class="mb-2">
                                    <h4 class="mb-1">Quotation Link</h4>
                                    <hr class="mt-1 mb-2"/>
                                    <div>
                                        <div name="quote_order" class="d-flex flex-column">
                                            <div name="quote_details" class="d-flex align-items-center justify-content-between">
                                                <a t-attf-href="/web/attachment/{{vendor_maintenance_request.vendor_quote_att.id}}">
                                                    <span t-field="vendor_maintenance_request.vendor_quote_att"/>
                                                </a>
                                            </div>
                                            <div class="small d-lg-inline-block">
                                                Date:
                                                <span t-field="vendor_maintenance_request.quote_submitted_time" t-options='{"widget": "date"}'/>
                                            </div>
                                        </div>
                                    </div>
                                        
                                </div>
                                <div id="maintenance_info" class="col-12 col-lg-6 mb-4">
                                    <span id="maintenance_info_title">
                                        <h5 class="mb-1">Maintenance Information</h5>
                                        <hr class="mt-1 mb-2"/>
                                    </span>
                                    <table class="table table-borderless table-sm">
                                        <tbody style="white-space:nowrap" id="maintenance_info_table">
                                            <tr>
                                                <th class="ps-0 pb-0">Name:</th>
                                                <td class="w-100 pb-0 text-wrap"><span t-field="vendor_maintenance_request.name"/></td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 pb-0">Date:</th>
                                                <td class="w-100 pb-0 text-wrap"><span t-field="vendor_maintenance_request.create_date" t-options='{"widget": "date"}'/></td>
                                            </tr>
                                            <tr t-if="vendor_maintenance_request.date_resolution">
                                                <th class="ps-0 pb-0">Date Resolution:</th>
                                                <td class="w-100 pb-0 text-wrap"><span t-field="vendor_maintenance_request.date_resolution" t-options='{"widget": "date"}'/></td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 pb-0">Client:</th>
                                                <td class="w-100 pb-0 text-wrap"><span t-field="vendor_maintenance_request.create_uid.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;,&quot;phone&quot;], &quot;no_marker&quot;: True}"/></td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 pb-0">Property Number:</th>
                                                <td class="w-100 pb-0 text-wrap"><span t-field="vendor_maintenance_request.property_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 pb-0">Attachment:</th>
                                                <td class="w-100 pb-0 text-wrap">
                                                    <t t-foreach="vendor_maintenance_request.attachment_ids" t-as="attachment_id">
                                                        <a t-attf-href="/web/attachment/{{attachment_id.id}}">
                                                            <span t-field="attachment_id.name"/>
                                                        </a><br/>
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 pb-0">Maintenance Type:</th>
                                                <td class="w-100 pb-0 text-wrap"><span t-field="vendor_maintenance_request.maintenance_type_id"/></td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 pb-0">Remarks:</th>
                                                <td class="w-100 pb-0 text-wrap"><span t-field="vendor_maintenance_request.description"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div role="dialog" class="modal fade" id="validationbox">
                            <div class="modal-dialog">
                                <form id="decline" method="POST" t-attf-action="/maintenance/create" class="modal-content">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <main class="modal-body">
                                        <p>
                                            Please fill out Date of Resolution field.
                                        </p>
                                    </main>
                                </form>
                            </div>
                        </div>
                        
                        <div role="dialog" class="modal fade" id="modaldateresolution">
                            <div class="modal-dialog">
                                <form id="decline" method="POST" t-attf-action="/vendor_maintenance/date_resolution/{{vendor_maintenance_request.id}}?access_token={{access_token}}" class="modal-content">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <header class="modal-header">
                                        <h4 class="modal-title">Date Resolution</h4>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </header>
                                    <main class="modal-body">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="row">
                                                    <div class="mb-3 field-login form-group">
                                                         <label class="form-label" for="date">
                                                            Date Resolution
                                                        </label>
                                                        <input type="date" name="date_resolution" id="date_resolution" required="required" class="form-control form-control-sm" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </main>
                                    <footer class="modal-footer">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-plus"></i> Confirm
                                        </button>
                                    </footer>
                                </form>
                            </div>
                        </div>
                        
                        <div role="dialog" class="modal fade" id="modalquote">
                            <div class="modal-dialog">
                                <form id="decline" method="POST" t-attf-action="/vendor_maintenance/attach_quote/{{vendor_maintenance_request.id}}?access_token={{access_token}}" class="modal-content">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <header class="modal-header">
                                        <h4 class="modal-title">Date Resolution</h4>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </header>
                                    <main class="modal-body">
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="row">
                                                    <div class="mb-3 field-login form-group">
                                                         <label class="form-label" for="date">
                                                            Attachment
                                                        </label>
                                                        <input type="file" name="quotation_data" id="fileQuoteInput" required="required" class="form-control form-control-sm" />
                                                    </div>
                                                    
                                                </div>
                                            </div>
                                        </div>
                                    </main>
                                    <footer class="modal-footer">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-plus"></i> Confirm
                                        </button>
                                    </footer>
                                </form>
                            </div>
                        </div>

                    </div>

                    <div id="maintenance_request_communication">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread"/>
                    </div>
                </div>

            </div>


