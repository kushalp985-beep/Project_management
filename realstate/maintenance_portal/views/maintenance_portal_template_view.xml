<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_maintenance" name="Portal layout : Maintenance Requests" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li id="portal_breadcrumbs_maintenance" t-if="page_name == 'maintenance'  or maintenance_request" t-attf-class="breadcrumb-item #{'active ' if not maintenance_request else ''}">
                <a t-if="maintenance_request" t-attf-href="/my/maintenance?{{ keep_query() }}">Maintenance Requests</a>
                <t t-else="">Maintenance Requests</t>
            </li>
            <li t-if="maintenance_request" class="breadcrumb-item active">
                <span t-field="maintenance_request.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_maintenance" name="Maintenance Requests" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
            <t t-set="portal_alert_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry" t-if="env.user.partner_id.is_client">
                <t t-set="icon" t-value="'/maintenance/static/description/icon.svg'"/>
                <t t-set="title">Maintenance Requests</t>
                <t t-set="url" t-value="'/my/maintenance'"/>
                <t t-set="text">Follow, view or create requests</t>
                <t t-set="placeholder_count" t-value="'maintenance_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

     <template id="portal_my_maintenance_requests" name="My Maintenance Requests">
        <t t-call="portal.portal_layout">
            <style>
                    .normal_lable {
                        font-size: 0.7rem;
                        color: #555;
                    }
                     /* Style the form group */
                        .form-group {
                          position: relative;
                          margin-bottom: 2rem;
                        }

                        /* Style for input fields */
                        .form-control {
                          border: 1px solid #ccc;
                          border-radius: 8px;
                          font-size: 1rem;
                          padding: 0.75rem;
                          outline: none;
                          width: 100%;
                        }

                        /* Position the label over the input field */
                        .form-label {
                          position: absolute;
                          top: 0;
                          left: 10px;
                          transform: translateY(-50%);
                          background: white;
                          padding: 0 5px;
                          font-size: 0.9rem;
                          color: #555;
                        }

                        /* Active input field style */
                        .form-control:focus {
                          border-color: #000;
                          outline: none;
                          box-shadow: none;
                        }
                    
                    
                    .image-container {
                      position: relative;
                    }
                    .image-container img {
                      width: 100%; /* Adjust as needed */
                      max-width: 100%;
                      position: relative;
                      z-index: 2;
                    }
                    .image-container .overlap {
                      width: 125%;
                      height: 100%;
                      background: transparent; /* Optional if you want a background for the overlap */
                      z-index: 1;
                    }
                    
                    body {
                        background-color: #f8f9fa;
                    }
                    .left-section {
                        background-color: #2b94d1;
                        color: white;
                        padding: 20px;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        align-items: center;
                    }
                    .left-section h2 {
                        font-size: 1.8rem;
                        text-align: center;
                    }
                    .form-container {
                        background-color: white;
                        padding: 30px;
                        border-radius: 10px;
                        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                    }
                    .form-title {
                        font-weight: bold;
                        text-align: center;
                        margin-bottom: 20px;
                    }
                    .submit-btn {
                        background-color: #2b94d1;
                        color: white;
                        font-weight: bold;
                    }
                    /* Image Preview */
                    #image-preview {
                        gap: 15px;
                    }
                    
                    .image-thumbnail-container {
                        position: relative;
                        width: 120px;
                        height: 120px;
                        border-radius: 8px;
                        overflow: hidden;
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                        transition: all 0.3s ease;
                    }
                    
                    .image-thumbnail-container:hover {
                        transform: scale(1.05);
                        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
                    }
                    
                    .image-thumbnail {
                        width: 100%;
                        height: 100%;
                        background-size: cover;
                        background-position: center;
                    }
                    
                    .remove-image {
                        position: absolute;
                        top: -8px;
                        right: -8px;
                        width: 28px;
                        height: 28px;
                        border-radius: 50%;
                        padding: 0;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 12px;
                        opacity: 0;
                        transition: opacity 0.3s ease;
                    }
                    
                    .image-thumbnail-container:hover .remove-image {
                        opacity: 1;
                    }
            </style>
