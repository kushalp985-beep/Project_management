<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>	
		<record id="account_move_form_view" model="ir.ui.view">
			<field name="name">Account Move form View</field>
			<field name="model">account.move</field>
 			<field name="inherit_id" ref="account.view_move_form"/>
			<field name="arch" type="xml">			
				<xpath expr="/form/header/button[@name='action_register_payment']" position="after">

					<button name="%(bliss_property_management.action_register_cheque_wizard)d"  type="action" string="Create PDC Cheque"  class="oe_highlight" invisible="state in ('draft') or not pdc_cheque"/>
				</xpath>
				<field name="payment_reference" position="after">
                	<field name="pdc_cheque" invisible="1" />
                </field>
				<xpath expr="//sheet" position="inside">
					<group string="Property" name="property_dimensions_group" colspan="2">
						<group>
							<field name="inv_contract_id" readonly="1"
							       invisible="not inv_contract_id"/>
							<field name="contract_id" readonly="1"
							       invisible="not contract_id or inv_contract_id"/>
							<field name="project_id" readonly="1"/>
						</group>
						<group>
							<field name="building_id" readonly="1"/>
							<field name="unit_id" readonly="1"/>
						</group>
					</group>
				</xpath>
		    </field>
		</record>

		<record id="account_move_search_view" model="ir.ui.view">
			<field name="name">account.move.search.property.dimensions</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_account_invoice_filter"/>
			<field name="arch" type="xml">
				<xpath expr="//search" position="inside">
					<field name="project_id"/>
					<field name="building_id"/>
					<field name="unit_id"/>
					<filter string="Project" name="filter_project" context="{'group_by': 'project_id'}"/>
					<filter string="Building" name="filter_building" context="{'group_by': 'building_id'}"/>
					<filter string="Unit" name="filter_unit" context="{'group_by': 'unit_id'}"/>
				</xpath>
			</field>
		</record>

		<record id="account_journal_form_view" model="ir.ui.view">
			<field name="name">Account Journal form View</field>
			<field name="model">account.journal</field>
 			<field name="inherit_id" ref="account.view_account_journal_form"/>
			<field name="arch" type="xml">			
				<field name="type" position="after">
                	<field name="cheque_payment"/>
                </field>
		    </field>
		</record>
    </data>
</odoo>
