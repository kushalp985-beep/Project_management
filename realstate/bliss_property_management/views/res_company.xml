<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_company_form_custom" model="ir.ui.view">
            <field name="name">view_company_form_inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <field name="currency_id" position="after">
                    <field name="ld_owner_no"/>
                    <field name="_id"/>
                    <field name="exp_id"/>
                    <field name="pp_no"/>
                </field>
            </field>
        </record>
    </data>
    <template id="view_company_form_custo" inherit_id="base.view_company_form">
        <xpath expr="//field[@name='partner_id']" position="attributes">
            <attribute name="groups">base.group_no_one,sales_team.group_sale_manager</attribute>
            <attribute name="invisible">0</attribute>
        </xpath>
    </template>

</odoo>
