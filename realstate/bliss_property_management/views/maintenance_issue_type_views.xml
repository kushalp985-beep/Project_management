<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_issue_type_tree" model="ir.ui.view">
        <field name="name">maintenance.issue.type.tree</field>
        <field name="model">maintenance.issue.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="maintenance_issue_type_form" model="ir.ui.view">
        <field name="name">maintenance.issue.type.form</field>
        <field name="model">maintenance.issue.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Subtypes" name="subtypes">
                            <field name="subtype_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maintenance_issue_subtype_tree" model="ir.ui.view">
        <field name="name">maintenance.issue.subtype.tree</field>
        <field name="model">maintenance.issue.subtype</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="issue_type_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_maintenance_issue_type" model="ir.actions.act_window">
        <field name="name">Issue Types &amp; Subtypes</field>
        <field name="res_model">maintenance.issue.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
