<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_unit_issue_form" model="ir.ui.view">
        <field name="name">maintenance.unit.issue.form</field>
        <field name="model">maintenance.unit.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign" type="object" string="Assign"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="maintenance_billing" invisible="1"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,assigned,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_maintenance_entry"
                                class="oe_stat_button" icon="fa-book"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Journal Entry"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="maintenance_billing" readonly="1"/>
                            <field name="owner_id" readonly="1"/>
                            <field name="building_id" domain="[('project_id', '=', project_id)]"
                                   options="{'no_create': True}"/>
                            <field name="unit_id" domain="[('building_id', '=', building_id)]"
                                   options="{'no_create': True}"/>
                            <field name="contract_id"/>
                        </group>
                        <group string="Tenant and Dates">
                            <field name="partner_id" invisible="1"/>
                            <field name="tenant_name"/>
                            <field name="mobile"/>
                            <field name="alternate_mobile"/>
                            <field name="complaint_date"/>
                            <field name="completion_date"/>
                            <field name="invoice_id" readonly="1"
                                   invisible="maintenance_billing != 'separate'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Issue">
                            <field name="issue_type_id" options="{'no_create': True}"/>
                            <field name="issue_subtype_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Assignment">
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="resource_calendar_id" readonly="1"/>
                        </group>
                        <group string="Amounts (Separate Billing)"
                               invisible="maintenance_billing != 'separate'">
                            <field name="currency_id" invisible="1"/>
                            <field name="price"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description / Notes">
                        <field name="description" nolabel="1" placeholder="Describe the issue..."/>
                    </group>
                    <notebook>
                        <page string="Before Repair Images" name="before_images">
                            <field name="before_attachment_ids" widget="many2many_binary" nolabel="1"/>
                        </page>
                        <page string="After Repair Images" name="after_images">
                            <field name="after_attachment_ids" widget="many2many_binary" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="maintenance_unit_issue_tree" model="ir.ui.view">
        <field name="name">maintenance.unit.issue.tree</field>
        <field name="model">maintenance.unit.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="maintenance_billing" optional="show"/>
                <field name="issue_type_id" optional="show"/>
                <field name="issue_subtype_id" optional="hide"/>
                <field name="tenant_name"/>
                <field name="employee_id"/>
                <field name="complaint_date"/>
                <field name="total_amount" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('assigned', 'in_progress')"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="maintenance_unit_issue_search" model="ir.ui.view">
        <field name="name">maintenance.unit.issue.search</field>
        <field name="model">maintenance.unit.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tenant_name"/>
                <field name="mobile"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="issue_type_id"/>
                <field name="issue_subtype_id"/>
                <field name="employee_id"/>
                <field name="maintenance_billing"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_assigned" string="Assigned" domain="[('state', '=', 'assigned')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('state', 'in', ('draft', 'assigned', 'in_progress'))]"/>
                <separator/>
                <filter name="filter_included_billing" string="Included Billing"
                        domain="[('maintenance_billing', '=', 'included')]"/>
                <filter name="filter_separate_billing" string="Separate Billing"
                        domain="[('maintenance_billing', '=', 'separate')]"/>
                <filter name="filter_invoiced" string="Invoiced"
                        domain="[('invoice_id', '!=', False)]"/>
                <filter name="filter_my_issues" string="My Issues"
                        domain="['|', ('create_uid', '=', uid), ('employee_id.user_id', '=', uid)]"/>
                <group>
                    <filter name="group_building" string="Building" context="{'group_by': 'building_id'}"/>
                    <filter name="group_billing" string="Billing Type" context="{'group_by': 'maintenance_billing'}"/>
                    <filter name="group_type" string="Issue Type" context="{'group_by': 'issue_type_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="maintenance_unit_issue_kanban" model="ir.ui.view">
        <field name="name">maintenance.unit.issue.kanban</field>
        <field name="model">maintenance.unit.issue</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="project_id"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="issue_type_id"/>
                <field name="issue_subtype_id"/>
                <field name="maintenance_billing"/>
                <field name="employee_id"/>
                <field name="complaint_date"/>
                <field name="total_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <br/>
                            <field name="building_id"/> / <field name="unit_id"/>
                            <br/>
                            <span t-if="record.issue_type_id.value">
                                <field name="issue_type_id"/> /
                                <field name="issue_subtype_id"/>
                            </span>
                            <br/>
                            <field name="maintenance_billing"/>
                            <br/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <br/>
                            <field name="complaint_date"/>
                            <t t-if="record.total_amount.raw_value">
                                <br/><field name="total_amount"/>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="maintenance_unit_issue_graph" model="ir.ui.view">
        <field name="name">maintenance.unit.issue.graph</field>
        <field name="model">maintenance.unit.issue</field>
        <field name="arch" type="xml">
            <graph string="Employee-wise Issues" type="bar">
                <field name="employee_id"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="maintenance_unit_issue_pivot" model="ir.ui.view">
        <field name="name">maintenance.unit.issue.pivot</field>
        <field name="model">maintenance.unit.issue</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Issues">
                <field name="employee_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_maintenance_unit_issue" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">maintenance.unit.issue</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
    </record>

</odoo>
