<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_contract" model="ir.sequence">
        <field name="name">Contract Sequence</field>
        <field name="code">Contract.seq.code</field>
        <field name="prefix">Con-%(year)s%(month)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_contract_renew" model="ir.sequence">
        <field name="name">Contract Renewal Sequence</field>
        <field name="code">Contract.renew.seq.code</field>
        <field name="prefix">ConRenew-%(year)s%(month)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_contract_term" model="ir.sequence">
        <field name="name">Contract Renewal Sequence</field>
        <field name="code">Contract.term.seq.code</field>
        <field name="prefix">ConTerm-%(year)s%(month)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>