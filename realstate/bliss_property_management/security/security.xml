<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.rule" id="project_restricted_company_rule">
            <field name="name">Project: multi-company</field>
            <field name="model_id" ref="model_property_project"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('managed_by', 'in', company_ids + [False])]</field>
        </record>
        <record model="ir.rule" id="building_restricted_company_rule">
            <field name="name">Building: multi-company</field>
            <field name="model_id" ref="model_property_building"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('project_id.managed_by', 'in', company_ids + [False])]</field>

        </record>
        <record model="ir.rule" id="unit_restricted_company_rule">
            <field name="name">unit: multi-company</field>
            <field name="model_id" ref="model_property_unit"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('project_id.managed_by', 'in', company_ids + [False])]</field>

        </record>
        <record model="ir.rule" id="contract_restricted_company_rule">
            <field name="name">Contract: multi-company</field>
            <field name="model_id" ref="model_property_contract"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>

        </record>

        <record model="ir.module.category" id="module_category_bliss_property_management">
            <field name="name">Property Contract</field>
            <field name="sequence">20</field>
        </record>

        <record id="user_company_rule" model="ir.rule">
			<field name="name">Account Cheque</field>
			<field name="model_id" ref="model_account_cheque"/>
			<field name="global" eval="True"/>
			<field name="domain_force">[('company_id' ,'=', user.company_id.id)]</field>
		</record>

    </data>
</odoo>
