<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record id="view_request_approval_form" model="ir.ui.view">
        <field name="name">request.approval.form</field>
        <field name="model">request.approval</field>
        <field name="arch" type="xml">
            <form string="Request Approval">
                <group>
                    <field name="contract_id" invisible="1"/>
                    <field name="user_ids" required="1"/>
                </group>
                <footer>
                    <button string="Send Request" name="request_approval" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>



</odoo>