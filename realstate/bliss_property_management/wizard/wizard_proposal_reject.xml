<?xml version="1.0"?>
<odoo>
     <record id="view_reject_proposal_wizard" model="ir.ui.view">
        <field name="name">reject.proposal.wizard.form</field>
        <field name="model">reject.proposal.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Proposal">
                <sheet>
                    <group>
                        <field name="reason"/>
                    </group>
                    <footer>
                        <button name="action_confirm_rejection" string="Confirm"  type="object" class="btn-primary" />
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>