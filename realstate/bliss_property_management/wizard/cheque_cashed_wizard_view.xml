<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cheque_cashed_wizard_form" model="ir.ui.view">
        <field name="name">cheque.cashed.wizard.form</field>
        <field name="model">cheque.cashed.wizard</field>
        <field name="arch" type="xml">
            <form string="Amount Cashed">
                <group>
                    <field name="cheque_id"/>
                    <field name="cashed_in_date"/>
                </group>
                <footer>
                    <button name="action_confirm_cashed"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cheque_cashed_wizard" model="ir.actions.act_window">
        <field name="name">Amount Cashed</field>
        <field name="res_model">cheque.cashed.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_cheque_id': active_id}</field>
    </record>
</odoo>
