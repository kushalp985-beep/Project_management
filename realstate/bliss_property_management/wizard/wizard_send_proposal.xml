<?xml version="1.0"?>
<odoo>
    <record id="view_send_proposal_wizard" model="ir.ui.view">
        <field name="name">send.proposal.wizard.form</field>
        <field name="model">send.proposal.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Proposal">
                <sheet>
                    <group>
                        <field name="attachment" widget="binary" filename="filename"/>
                        <field name="filename"/>

                    </group>
                    <footer>
                        <button name="action_confirm_send" string="Save"  type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
