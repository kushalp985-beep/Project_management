<odoo>

    <record id="view_contract_termination_inspection_wizard_form" model="ir.ui.view">
        <field name="name">contract.termination.inspection.wizard.form</field>
        <field name="model">contract.termination.inspection.wizard</field>
        <field name="arch" type="xml">
            <form string="Inspection Details">
                <group>
                    <field name="paint_condition"/>
                    <field name="paint_remarks"/>

                    <field name="door_condition"/>
                    <field name="door_remarks"/>

                    <!-- <field name="fan_condition"/> -->
                    <field name="light_condition"/>
                    <!-- <field name="ac_condition"/> -->

                    <field name="appliance_remarks"/>
                    <field name="inspection_attachment_ids" widget="many2many_binary"/>
                </group>

                <footer>
                    <button string="Confirm Inspection"
                            type="object"
                            name="action_confirm_inspection"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
s

</odoo>