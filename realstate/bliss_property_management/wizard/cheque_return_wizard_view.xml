<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cheque_return_wizard_form" model="ir.ui.view">
        <field name="name">cheque.return.wizard.form</field>
        <field name="model">cheque.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Cheque">
                <group>
                     <field name="cheque_id"/>
                    <field name="cheque_return_date"/>
                    <field name="cheque_return_reason"/>
                </group>

                <footer>
                    <button name="action_confirm_return"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_cheque_return_wizard" model="ir.actions.act_window">
        <field name="name">Return Cheque</field>
        <field name="res_model">cheque.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_cheque_id': active_id}</field>
    </record>



</odoo>
