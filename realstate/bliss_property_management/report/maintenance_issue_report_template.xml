<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_maintenance_unit_issue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Unit Maintenance Issue</h2>
                        <h3 class="text-center"><span t-field="doc.name"/></h3>

                        <table class="table table-sm mt-4">
                            <tr>
                                <td><strong>Status</strong></td>
                                <td><span t-field="doc.state"/></td>
                                <td><strong>Complaint Date</strong></td>
                                <td><span t-field="doc.complaint_date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Unit</strong></td>
                                <td><span t-field="doc.unit_id"/></td>
                                <td><strong>Issue Type</strong></td>
                                <td>
                                    <span t-field="doc.issue_type_id"/>
                                    <t t-if="doc.issue_subtype_id"> / <span t-field="doc.issue_subtype_id"/></t>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Tenant</strong></td>
                                <td><span t-field="doc.tenant_name"/></td>
                                <td><strong>Mobile</strong></td>
                                <td><span t-field="doc.mobile"/></td>
                            </tr>
                            <tr>
                                <td><strong>Alternate Number</strong></td>
                                <td><span t-field="doc.alternate_mobile"/></td>
                                <td><strong>Assigned Employee</strong></td>
                                <td><span t-field="doc.employee_id"/></td>
                            </tr>
                            <tr t-if="doc.resource_calendar_id">
                                <td><strong>Working Schedule</strong></td>
                                <td colspan="3"><span t-field="doc.resource_calendar_id"/></td>
                            </tr>
                        </table>

                        <h4 class="mt-3">Description / Notes</h4>
                        <p t-if="doc.description"><span t-field="doc.description"/></p>
                        <p t-else="">—</p>

                        <t t-if="doc.before_attachment_ids">
                            <h4 class="mt-4">Before Repair Images</h4>
                            <div class="row">
                                <t t-foreach="doc.before_attachment_ids" t-as="attachment">
                                    <div class="col-4 text-center mb-3" t-if="attachment.mimetype and attachment.mimetype.startswith('image/')">
                                        <img t-att-src="image_data_uri(attachment.datas)"
                                             t-att-alt="attachment.name"
                                             style="max-width: 100%; max-height: 250px;"/>
                                        <p class="small text-muted" t-esc="attachment.name"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <t t-if="doc.after_attachment_ids">
                            <h4 class="mt-4">After Repair Images</h4>
                            <div class="row">
                                <t t-foreach="doc.after_attachment_ids" t-as="attachment">
                                    <div class="col-4 text-center mb-3" t-if="attachment.mimetype and attachment.mimetype.startswith('image/')">
                                        <img t-att-src="image_data_uri(attachment.datas)"
                                             t-att-alt="attachment.name"
                                             style="max-width: 100%; max-height: 250px;"/>
                                        <p class="small text-muted" t-esc="attachment.name"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
