<odoo>
    <record id="sale_order_form_inherit_payment_date" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.payment.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="payment_date"/>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Customer Alternate Address">
                    <group>
                        <group>
                            <field name="customer_alt_street"/>
                            <field name="customer_alt_street2"/>
                            <field name="customer_alt_city"/>
                            <field name="customer_alt_zip"/>
                        </group>
                        <group>
                            <field name="customer_alt_country_id"/>
                            <field name="customer_alt_state_id"/>
                            <field name="customer_alt_country_code" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
