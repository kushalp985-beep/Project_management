<odoo>
    <record id="student_form_inherit_alternate_address" model="ir.ui.view">
        <field name="name">student.management.form.alternate.address</field>
        <field name="model">student.management</field>
        <field name="inherit_id" ref="student_management.student_form_view"/>

        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Alternate Address">
                <group>
                    <group>
                        <field name="alternate_street" placeholder="Street..."/>
                        <field name="alternate_street2" placeholder="Street 2..."/>
                        <div class="o_address_format">
                            <field name="alternate_city"
                                placeholder="City"
                                class="o_address_city"/>
                            <field name="alternate_state_id"
                                placeholder="State"
                                class="o_address_state"
                                options="{'no_open': True, 'no_create': True}"/>
                            <field name="alternate_zip"
                                placeholder="ZIP"
                                class="o_address_zip"/>
                            <field name="alternate_country_id"
                                placeholder="Country"
                                class="o_address_country"
                                options="{'no_open': True, 'no_create': True}"/>
                        </div>
                        <field name="alternate_country_code" invisible="1"/>
                    </group>
                </group>
            </page>
            </xpath>
        </field>
    </record>
</odoo>
