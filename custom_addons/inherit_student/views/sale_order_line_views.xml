<odoo>
    <record id="sale_order_line_form_inherit_discount" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='tax_id']" position="after">
             <field name="custom_discount_percentage"/>
            </xpath>
        </field>
    </record>
</odoo>