
<odoo>
    <record id="email_template_student_details" model="mail.template">
        <field name="name">Student Details Email</field>
        <field name="model_id" ref="model_student_management"/>
        <field name="subject">Student Details - {{ object.name }}</field>
        <field name="email_to">{{ object.email or '' }}</field>
        <field name="body_html" type="html">
           <div>
                <p>Dear <t t-out="object.name or 'Student'"/>,</p>

                <p>You are successfully enrolled in our school.</p>  

                   <p>Thanks</p>

                <p>Regards</p>
           </div>
        </field>
    </record>
</odoo>
