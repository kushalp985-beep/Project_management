
<odoo>
    <record id="action_student_details_pdf" model="ir.actions.report">
        <field name="name">Student Details PDF</field>
        <field name="model">student.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.student_report_template</field>
        <field name="report_file">student_management.student_report_template</field>
        <field name="binding_model_id" ref="model_student_management"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_student_xlsx" model="ir.actions.server">
       <field name="name">Student XLSX Report</field>
       <field name="model_id" ref="model_student_management"/>
       <field name="binding_model_id" ref="model_student_management"/>
       <field name="binding_type">report</field>
       <field name="state">code</field>
       <field name="code">
          action = records.action_download_student_xlsx()
    </field>
</record>

<record id="student_html_report_action" model="ir.actions.report">
    <field name="name">Student HTML Report</field>
    <field name="model">student.management</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">student_management.student_report_template</field>
    <field name="report_file">student_management.student_report_templat e</field>
</record>
</odoo>
