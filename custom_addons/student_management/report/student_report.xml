
<odoo>
    <template id="student_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="student">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <h2 class="text-center">Student Details</h2>

                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th>Student Name</th>
                                    <td><span t-field="student.name"/></td>
                                </tr>
                                <tr>
                                    <th>Admission Date</th>
                                    <td><span t-field="student.admission_date"/></td>
                                </tr>
                                <tr>
                                    <th>Date of Birth</th>
                                    <td><span t-field="student.date_of_birth"/></td>
                                </tr>
                                <tr>
                                    <th>Gender</th>
                                    <td><span t-field="student.gender"/></td>
                                </tr>
                                <tr>
                                    <th>Mobile</th>
                                    <td><span t-field="student.mobile"/></td>
                                </tr>
                                <tr>
                                    <th>Email</th>
                                    <td><span t-field="student.email"/></td>
                                </tr>
                                <tr>
                                    <th>Standard / Class</th>
                                    <td><span t-field="student.standard_id"/></td>
                                </tr>
                                <tr>
                                    <th>Street</th>
                                    <td><span t-field="student.street"/></td>
                                </tr>
                                <tr>
                                    <th>City</th>
                                    <td><span t-field="student.city"/></td>
                                </tr>
                                <tr>
                                    <th>State</th>
                                    <td><span t-field="student.state_id"/></td>
                                </tr>
                                <tr>
                                    <th>Country</th>
                                    <td><span t-field="student.country_id"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

