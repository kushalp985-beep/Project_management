<odoo>
    <data noupdate="1">
        <record id="student_birthday_reminder_cron" model="ir.cron">
            <field name="name">Student Birthday Reminder</field>
            <field name="model_id" ref="model_student_management"/>
            <field name="state">code</field>
            <field name="code">model.student_birthday_reminder()</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
    </data>
</odoo> 