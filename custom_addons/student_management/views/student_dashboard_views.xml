<odoo>

    <record id="view_student_dashboard_form" model="ir.ui.view">
        <field name="name">student.dashboard.form</field>
        <field name="model">student.dashboard</field>
        <field name="arch" type="xml">
           <form string="Student Dashboard">
            <sheet>
                <notebook>
                    <page string="Students">
                        <field name="students">
                            <list>
                                <field name="name"/>
                                <field name="admission_date"/>
                                <field name="date_of_birth"/>
                                <field name="gender"/>
                                <field name="mobile"/>
                                <field name="email"/>
                            </list>
                        </field>
                    </page>

                    <page string="Teachers">
                        <field name="teachers">
                            <list>
                                <field name="name"/>
                                <field name="date_of_birth"/>
                                <field name="gender"/>
                                <field name="mobile"/>
                                <field name="email"/>
                                <field name="city"/>
                                <field name="standard_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Subjects">
                        <field name="subjects">
                            <list>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="maximum_marks"/>
                                <field name="passing_marks"/>
                                <field name="subject_type"/>
                                <field name="standard_ids" widget="many2many_tags"/>
                                <field name="subject_teacher_id" widget="many2many_tags"/>
                            </list>
                        </field>
                    </page>
                    <page string="Standards">
                        <field name="standards">
                            <list>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="subject_ids" widget="many2many_tags"/>
                                <field name="class_teacher"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </page>
                   <page string="Marksheets">
                        <field name="marksheets">
                            <list>
                                <field name="student_id"/>
                                <field name="standard"/>
                                <field name="academic_year"/>
                                <field name="exam"/>
                                <field name="exam_date"/>
                                <field name="total_marks"/>
                                <field name="passing_marks"/>
                                <field name="obtained_marks"/>
                                <field name="percentage"/>
                                <field name="result"/>
                                <field name="grade"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
        </field>
    </record>

  <record id="view_student_dashboard_list" model="ir.ui.view">
    <field name="name">student.dashboard.list</field>
    <field name="model">student.dashboard</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="total_students"/>
        </list>
    </field>
</record>

<record id="action_student_dashboard" model="ir.actions.act_window">
    <field name="name">Student Dashboard</field>
    <field name="res_model">student.dashboard</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
</record>

<record id="action_student_dashboard_graph" model="ir.actions.client">
    <field name="name">Student Dashboard</field>
    <field name="tag">student_management_dashboard</field>
</record>

<record id="student_dashboard_record" model="student.dashboard">
    <field name="name">Student Dashboard</field>
</record>

<menuitem
    id="menu_student_dashboard"
    name="Dashboard"
    parent="student_management_menu"
    action="action_student_dashboard_graph"
    sequence="1"/>

</odoo>
