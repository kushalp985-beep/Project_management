<odoo>

    <record id="marksheet_list_view" model="ir.ui.view">
        <field name="name">marks.sheet.list.view</field>
        <field name="model">student.marks.sheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                        <field name="standard"/>
                        <field name="academic_year"/>
                        <field name="exam"/>
                        <field name="exam_date"/>
                        <field name="total_marks"/>
                        <field name="obtained_marks"/>
                        <field name="percentage"/>
                        <field name="result"/>
                        <field name="grade"/>
            </list>
        </field>
    </record>


    
    <record id="marks_sheet_form_view" model="ir.ui.view">
        <field name="name">marks.sheet.form.view</field>
        <field name="model">student.marks.sheet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="standard"/>
                        <field name="academic_year"/>
                        <field name="exam"/>
                        <field name="exam_date"/>
                        <field name="total_marks"/>
                        <field name="obtained_marks"/>
                        <field name="percentage"/>
                        <field name="result"/>
                       <field name="grade"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


   
    <record id="action_marks_sheet" model="ir.actions.act_window">
        <field name="name">Marks sheets</field>
        <field name="res_model">student.marks.sheet</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="marksheet_menu"
              name="Marks sheets"
              parent="student_management_menu"
              action="action_marks_sheet"/>


              
    <record id="student_marksheet_kanban_view" model="ir.ui.view">
        <field name="name">student.marks.sheet.kanban</field>
        <field name="model">student.marks.sheet</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="student_id"/>
                <field name="standard"/>
                <field name="academic_year"/>
                <field name="exam"/>
                <field name="exam_date"/>
                <field name="total_marks"/>
                <field name="passing_marks"/>
                <field name="obtained_marks"/>
                <field name="percentage" readonly="1"/>
                <field name="result" readonly="1"/>
                <field name="grade" readonly="1"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold fs-5">
                                <field name="student_id"/>
                            </div>

                            <div class="mt-2">
                                <strong>Standard: </strong>
                                <field name="standard"/>
                            </div>

                            <div>
                                <strong>Exam: </strong>
                                <field name="exam"/>
                            </div>

                            <div>
                                <strong>Academic Year: </strong>
                                <field name="academic_year"/>
                            </div>

                            <div>
                                <strong>Exam Date: </strong>
                                <field name="exam_date"/>
                            </div>

                            <div>
                                <strong>Marks: </strong>
                                <field name="obtained_marks"/>
                                /
                                <field name="total_marks"/>
                                <field name="passing_marks"/>
                            </div>

                            <div>
                                <strong>Percentage: </strong>
                                <field name="percentage"/>%
                            </div>

                            <div>
                                <strong>Grade: </strong>
                                <field name="grade"/>
                            </div>

                            <div class="mt-2">
                                <strong>Result: </strong>
                                <field name="result"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
           

</odoo>