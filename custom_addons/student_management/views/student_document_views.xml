
<odoo>
    <record id="student_document_list_view" model="ir.ui.view">
        <field name="name">student.document.list</field>
        <field name="model">student.document</field>
        <field name="arch" type="xml">
            <list string="Student Documents">
                <field name="student_id"/>
                <field name="document_name"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="student_document_form_view" model="ir.ui.view">
        <field name="name">student.document.form</field>
        <field name="model">student.document</field>
        <field name="arch" type="xml">
            <form string="Student Documents">
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="document_name"/>
                        <field name="aadhar_card" filename="document_name"/>
                        <field name="marksheet"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="student_document_action" model="ir.actions.act_window">
        <field name="name">Student Documents</field>
        <field name="res_model">student.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_documents"
              name="Student Documents"
              action="student_document_action"/>
</odoo>
