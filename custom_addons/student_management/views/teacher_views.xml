<odoo>

    <record id="teacher_list_view" model="ir.ui.view">
        <field name="name">student.teacher.list.view</field>
        <field name="model">student.teacher</field>
        <field name="arch" type="xml">

            <list>
                    <field name="name"/>
                    <field name="date_of_birth"/>
                    <field name="email"/>
                    <field name="gender"/>
                    <field name="street" placeholder="Street..." class="o_address_street"/>
                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                    <field name="city" placeholder="City" class="o_address_city"/>
                    <field name="state_id" placeholder="State" class="o_address_state"
                       options="{'no_open': True}"/>
                    <field name="country_id" placeholder="Country" class="o_address_country"
                      options="{'no_open': True}"/> 
            </list>
        </field>
    </record>


    <record id="teacher_form_view" model="ir.ui.view">
        <field name="name">student.teacher.form.view</field>
        <field name="model">student.teacher</field>
        <field name="arch" type="xml">
<form>
    <sheet>
        <div class="d-flex justify-content-between align-items-start">
            <div class="oe_title">
                <label for="name"/>
                <h1>
                    <field name="name" placeholder="Teacher Name"/>
                </h1>
            </div>

            <field name="photo"
                   widget="image"
                   class="oe_avatar"
                   nolabel="1"
                   options="{'size': [150, 150]}"/>
        </div>

           <group>
                 <group>
                       <label for="street" string="Address"/>
                       <div class="o_address_format">
                       <field name="street" placeholder="Street..." class="o_address_street"/>
                       <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                       <field name="city" placeholder="City" class="o_address_city"/>
                       <field name="state_id" placeholder="State" class="o_address_state" options="{'no_open': True, 'no_create': True}" context="{'country_id': country_id, 'default_country_id': country_id}"/>
                        <div name="partner_address_country" class="d-flex justify-content-between">
                       <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>                       
                  </div>
                  </div>
                    </group>
                         <group>
                            <field name="name"/>
                            <field name="date_of_birth"/>
                            <field name="gender"
                               widget="radio"
                               options="{'horizontal': true}"/>
                         <field name="mobile" widget="phone" options="{'enable_sms': false}"/>
                         <field name="email" widget="email" options="{'enable_sms': false}"/>
                    </group>
                </group>

        <notebook>
            <page string="Teaching Details">
                <field name="subject_ids">
                    <list>
                        <field name="name" string="Subject"/>
                        <field name="standard_ids"
                               widget="many2many_tags"
                               string="Standards"/>
                        </list>
                      </field>
                    </page>
                  </notebook>
                </sheet>
              </form>
           </field>
        </record>


    <record id="action_teacher" model="ir.actions.act_window">
        <field name="name">Teacher</field>
        <field name="res_model">student.teacher</field>
        <field name="view_mode">kanban,list,form</field>
    </record>


    <menuitem id="menu_teacher"
        name="Teacher"
        parent="student_management_menu"
        action="action_teacher"/> 

    <record id="student_teacher_kanban_view" model="ir.ui.view">
        <field name="name">student.teacher.kanban</field>
        <field name="model">student.teacher</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="photo"
                 widget="image"
                 class="oe_avatar"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold fs-5">
                                <field name="name"/>
                            </div>

                            <div>
                                <strong>Mobile: </strong>
                                <field name="mobile"/>
                            </div>

                            <div>
                                <strong>Email: </strong>
                                <field name="email"/>
                            </div>

                            <div class="mt-2">
                                <field name="active" widget="boolean"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
