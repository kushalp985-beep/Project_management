<odoo>

    <record id="view_student_document_wizard_form" model="ir.ui.view">
        <field name="name">student.document.wizard.form</field>
        <field name="model">student.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Student Documents">

                <group>
                    <field name="student_id"/>
                    <field name="document_name"/>
                    <field name="document_attachment_ids" widget="many2many_binary" string="Upload Documents"/>
                    <field name="document_notes"/>  
                </group>

                <footer>
                <button name="action_submit"
                       type="object"
                       string="Submit"
                       class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>