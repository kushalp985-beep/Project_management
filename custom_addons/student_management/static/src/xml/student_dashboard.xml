<templates xml:space="preserve">
    <t t-name="student_management.StudentDashboard">
        <div class="o_student_dashboard p-4">
            <h2>Student Management Dashboard</h2>

            <div class="row g-4 mt-2">
                <div class="col-md-6">
                    <div class="card p-3">
                        <h4>All Students</h4>
                        <div style="height:250px;">
                            <canvas t-ref="students"/>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card p-3">
                        <h4>All Teachers</h4>
                        <div style="height:250px;">
                            <canvas t-ref="teachers"/>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card p-3">
                        <h4>All Standards</h4>
                        <div style="height:250px;">
                            <canvas t-ref="standards"/>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card p-3">
                        <h4>All Subjects</h4>
                        <div style="height:250px;">
                            <canvas t-ref="subjects"/>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card p-3">
                        <h4>All Marksheets</h4>
                        <div style="height:250px;">
                            <canvas t-ref="marksheets"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
